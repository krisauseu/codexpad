abi <abi/4.0>,
include <tunables/global>

profile codexpad-sandbox-test-bwrap /opt/codexpad-sandbox-test/bin/codex-resources/bwrap flags=(attach_disconnected) {
  userns,
  / r,
  capability sys_admin,
  capability net_admin,
  deny capability setpcap,
  deny capability sys_ptrace,
  network unix dgram,
  network netlink raw,
  /proc/sys/kernel/overflowuid r,
  /proc/sys/kernel/overflowgid r,
  /proc/[0-9]*/uid_map rw,
  /proc/[0-9]*/setgroups rw,
  /proc/[0-9]*/gid_map rw,
  /proc/[0-9]*/mountinfo r,
  deny /proc/[0-9]*/fd/ r,
  mount options=(rw silent rslave) /,
  mount options=(rw silent rprivate) /oldroot/,
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /tmp/,
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /newroot/,
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /newroot/dev/,
  mount fstype=devpts options=(rw nosuid noexec) devpts -> /newroot/dev/pts/,
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /newroot/tmp/codex-daemon-1000/,
  mount fstype=proc options=(rw nosuid nodev noexec) proc -> /newroot/proc/,
  /tmp/newroot/ w,
  /tmp/oldroot/ w,
  /newroot/dev/ w,
  /newroot/dev/null w,
  /newroot/dev/zero w,
  /newroot/dev/full w,
  /newroot/dev/random w,
  /newroot/dev/urandom w,
  /newroot/dev/tty w,
  /newroot/dev/stdin w,
  /newroot/dev/stdout w,
  /newroot/dev/stderr w,
  /newroot/dev/fd w,
  /newroot/dev/core w,
  /newroot/dev/shm/ w,
  /newroot/dev/pts/ w,
  /newroot/dev/ptmx w,
  mount options=(rw rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount options=(rw rbind) /oldroot/ -> /newroot/,
  mount options=(rw rbind) /oldroot/dev/null -> /newroot/dev/null,
  mount options=(rw rbind) /oldroot/dev/zero -> /newroot/dev/zero,
  mount options=(rw rbind) /oldroot/dev/full -> /newroot/dev/full,
  mount options=(rw rbind) /oldroot/dev/random -> /newroot/dev/random,
  mount options=(rw rbind) /oldroot/dev/urandom -> /newroot/dev/urandom,
  mount options=(rw rbind) /oldroot/dev/tty -> /newroot/dev/tty,
  mount options=(ro nosuid nodev remount bind silent relatime) -> /newroot/,
  mount options=(ro nosuid nodev remount bind silent relatime) -> /newroot/tmp/codex-daemon-1000/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  umount /oldroot/,
}
